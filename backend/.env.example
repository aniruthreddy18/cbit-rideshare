# ---- Required ---------------------------------------------------------------
# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Use a DATABASE USER's credentials (Atlas > Security > Database Access).
# URL-encode special characters in the password (@ -> %40, # -> %23, : -> %3A).
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=cbit-rideshare

# Long random string (min 32 chars). Generate one in Terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# ---- Optional ---------------------------------------------------------------
PORT=5050
MONGO_DB_NAME=cbit_rideshare
JWT_EXPIRES_IN=7d
# Frontend URL(s) allowed by CORS, comma separated.
CLIENT_ORIGIN=http://localhost:5173
# Uncomment if you get "querySrv ECONNREFUSED/ENOTFOUND" (DNS blocks Atlas SRV lookups).
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Max login/register attempts per IP per 15 minutes.
AUTH_RATE_LIMIT=50
# Set to 1 when deployed behind a hosting proxy (Render). Defaults to 1 when NODE_ENV=production.
# TRUST_PROXY=1
